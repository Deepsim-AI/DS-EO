# ============================================================================
# DS-EO DSH Edition — Environment Configuration
# Copy this file to .env and adjust values for your deployment.
# ============================================================================

# ---------------------------------------------------------------------------
# DSH (DeepSeek Harness) API Configuration [REQUIRED]
# ---------------------------------------------------------------------------
# Base URL of the DeepSeek Harness API endpoint.
# When configured, all 10 RuntimeAPI methods attempt real DSH calls.
# Examples:
#   Development: http://localhost:8080/api
#   Production:  https://dsh.example.com/api
DSH_API_BASE=

# Bearer token for DSH API authentication (optional).
# If DSH_API_BASE is set but DSH_API_TOKEN is not, unauthenticated requests
# will be attempted. Some endpoints may reject them.
DSH_API_TOKEN=

# ---------------------------------------------------------------------------
# Model Fallback Configuration [OPTIONAL]
# ---------------------------------------------------------------------------
# Host and port for the Ollama instance (used as model fallback).
# Only needed if running without a live DSH API endpoint.
OLLAMA_HOST=localhost:11434

# ---------------------------------------------------------------------------
# DS-EO Runtime Configuration [OPTIONAL]
# ---------------------------------------------------------------------------
# Workspace root for DS-EO tasks and state management.
# Defaults to the directory containing ds_eo_dsh/.
WORKSPACE_ROOT=

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO).
LOG_LEVEL=INFO
